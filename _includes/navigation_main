{%- comment -%}
  사이트 메뉴 (홈·목록 화면 좌측).
  그룹 제목: 아이콘 타일 + 굵은 글씨 / 링크: 들여쓰기 + 오른쪽 아이콘(블로그 내부 ›, 외부 사이트 ↗)
{%- endcomment -%}
{% assign navigation = site.data.navigation.docs %}

<nav class="nav__list" aria-label="사이트 메뉴">
  <input id="ac-nav" name="accordion-nav" type="checkbox" />
  <label for="ac-nav">{{ site.data.ui-text[site.locale].menu_label | default: "Toggle Menu" }}</label>
  <ul class="nav__items">
    {% for nav in navigation %}
      {%- case nav.title -%}
        {%- when "Books" -%}{%- assign group_icon = "fas fa-book" -%}
        {%- when "Lectures" -%}{%- assign group_icon = "fas fa-play-circle" -%}
        {%- when "Utilities" -%}{%- assign group_icon = "fas fa-wrench" -%}
        {%- when "Content" -%}{%- assign group_icon = "fas fa-layer-group" -%}
        {%- when "Extras" -%}{%- assign group_icon = "fas fa-th-large" -%}
        {%- else -%}{%- assign group_icon = nav.icon | default: "fas fa-folder" -%}
      {%- endcase -%}
      <li class="nav__group">
        <span class="nav__group-title"><span class="nav__group-icon" aria-hidden="true"><i class="{{ group_icon }}"></i></span>{{ nav.title }}</span>
        {% if nav.children != null %}
        <ul class="nav__group-links">
          {% for child in nav.children %}
            {%- assign child_url = child.url | relative_url -%}
            <li>
              <a class="nav__link{% if child_url == page.url %} active{% endif %}" href="{{ child_url }}"{% if child_url == page.url %} aria-current="page"{% endif %}{% if child.external %} target="{{ child.external }}" rel="noopener noreferrer"{% endif %}>
                <span class="nav__link-label">{{ child.title }}</span>
                {% if child.external %}
                  <i class="fas fa-external-link-alt nav__link-icon" aria-hidden="true"></i><span class="sr-only">(새 창)</span>
                {% else %}
                  <i class="fas fa-chevron-right nav__link-icon" aria-hidden="true"></i>
                {% endif %}
              </a>
            </li>
          {% endfor %}
        </ul>
        {% endif %}
      </li>
    {% endfor %}
  </ul>
</nav>
