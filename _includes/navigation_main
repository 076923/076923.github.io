{% assign navigation = site.data.navigation.docs %}

<nav class="nav__list" aria-label="사이트 메뉴">
  <input id="ac-nav" name="accordion-nav" type="checkbox" />
  <label for="ac-nav">{{ site.data.ui-text[site.locale].menu_label | default: "Toggle Menu" }}</label>
  <ul class="nav__items">
    {% for nav in navigation %}
      <li class="nav__group">
        {% if nav.url %}
          <a href="{{ nav.url | relative_url }}"><span class="nav__sub-title">{{ nav.title }}</span></a>
        {% else %}
          <span class="nav__sub-title">{{ nav.title }}</span>
        {% endif %}

        {% if nav.children != null %}
        <ul>
          {% for child in nav.children %}
            {% if child.grandchild != null %}
              <li>{{ child.title }}
                <ul>
                {% for grand in child.grandchild %}
                  <li><a href="{{ grand.url | relative_url }}"{% if grand.url == page.url %} class="active" aria-current="page"{% endif %}>{{ grand.title }}</a></li>
                {% endfor %}
                </ul>
              </li>
            {% else %}
              <li><a href="{{ child.url | relative_url }}"{% if child.url == page.url %} class="active" aria-current="page"{% endif %}{% if child.external %} target="{{ child.external }}" rel="noopener noreferrer"{% endif %}>{{ child.title }}</a></li>
            {% endif %}
          {% endfor %}
        </ul>
        {% endif %}
      </li>
    {% endfor %}
  </ul>
</nav>
